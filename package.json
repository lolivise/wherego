{
  "name": "wherego",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:sim": "node tools/stubs/sim.mjs",
    "test:worker": "node tools/stubs/worker.mjs",
    "build": "pnpm --filter @wherego/web build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
